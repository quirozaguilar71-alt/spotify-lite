import express from 'express';
import cors from 'cors';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import Database from 'better-sqlite3';
import { demoTracks, demoPlaylists } from './seedData.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const app = express();
const PORT = process.env.PORT || 4000;

const dataDir = path.join(__dirname, 'data');
if (!fs.existsSync(dataDir)) {
  fs.mkdirSync(dataDir, { recursive: true });
}

const dbPath = path.join(dataDir, 'spotify-lite.db');
const db = new Database(dbPath);
db.pragma('journal_mode = WAL');

const createSchema = () => {
  db.exec(`
    CREATE TABLE IF NOT EXISTS tracks (
      id INTEGER PRIMARY KEY,
      title TEXT NOT NULL,
      artist TEXT NOT NULL,
      album TEXT NOT NULL,
      genre TEXT NOT NULL,
      duration INTEGER NOT NULL,
      cover TEXT NOT NULL,
      preview_url TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS playlists (
      id INTEGER PRIMARY KEY,
      name TEXT NOT NULL,
      description TEXT NOT NULL,
      cover TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS playlist_tracks (
      playlist_id INTEGER NOT NULL,
      track_id INTEGER NOT NULL,
      FOREIGN KEY(playlist_id) REFERENCES playlists(id),
      FOREIGN KEY(track_id) REFERENCES tracks(id)
    );
  `);
};

const seedDatabase = () => {
  const trackCount = db.prepare('SELECT COUNT(*) AS count FROM tracks').get().count;
  if (trackCount === 0) {
    const insertTrack = db.prepare(`
      INSERT INTO tracks (id, title, artist, album, genre, duration, cover, preview_url)
      VALUES (@id, @title, @artist, @album, @genre, @duration, @cover, @previewUrl)
    `);

    const insertPlaylist = db.prepare(`
      INSERT INTO playlists (id, name, description, cover)
      VALUES (@id, @name, @description, @cover)
    `);

    const insertPlaylistTrack = db.prepare(`
      INSERT INTO playlist_tracks (playlist_id, track_id) VALUES (@playlistId, @trackId)
    `);

    const transaction = db.transaction(() => {
      demoTracks.forEach((track) => insertTrack.run(track));
      demoPlaylists.forEach((playlist) => {
        insertPlaylist.run({
          id: playlist.id,
          name: playlist.name,
          description: playlist.description,
          cover: playlist.cover,
        });

        playlist.tracks.forEach((trackId) => {
          insertPlaylistTrack.run({ playlistId: playlist.id, trackId });
        });
      });
    });

    transaction();
  }
};

createSchema();
seedDatabase();

app.use(cors());
app.use(express.json());

app.get('/api/health', (req, res) => {
  res.json({ ok: true, message: 'Spotify Lite API is running', timestamp: new Date().toISOString() });
});

app.post('/api/login', (req, res) => {
  const username = req.body?.username || 'guest';
  res.json({
    token: 'demo-token',
    user: {
      name: username,
      plan: 'Premium',
    },
  });
});

app.get('/api/tracks', (req, res) => {
  const tracks = db.prepare('SELECT * FROM tracks ORDER BY id ASC').all();
  res.json({ tracks });
});

app.get('/api/playlists', (req, res) => {
  const playlists = db.prepare('SELECT * FROM playlists ORDER BY id ASC').all();
  const withTracks = playlists.map((playlist) => {
    const tracks = db
      .prepare(`
        SELECT t.*
        FROM playlist_tracks pt
        JOIN tracks t ON t.id = pt.track_id
        WHERE pt.playlist_id = ?
      `)
      .all(playlist.id);

    return { ...playlist, tracks };
  });

  res.json({ playlists: withTracks });
});

app.get('/api/search', (req, res) => {
  const query = (req.query.q || '').toString().trim();

  if (!query) {
    const tracks = db.prepare('SELECT * FROM tracks ORDER BY id ASC').all();
    return res.json({ tracks });
  }

  const searchTerm = `%${query}%`;
  const tracks = db.prepare(`
    SELECT *
    FROM tracks
    WHERE title LIKE ?
       OR artist LIKE ?
       OR album LIKE ?
       OR genre LIKE ?
    ORDER BY title ASC
  `).all(searchTerm, searchTerm, searchTerm, searchTerm);

  res.json({ tracks });
});

app.get('/api/library', (req, res) => {
  const tracks = db.prepare('SELECT * FROM tracks ORDER BY id DESC LIMIT 5').all();
  res.json({ tracks });
});

const distPath = path.join(__dirname, '../dist');
if (fs.existsSync(distPath)) {
  app.use(express.static(distPath));

  app.get('*', (req, res) => {
    res.sendFile(path.join(distPath, 'index.html'));
  });
}

app.listen(PORT, () => {
  console.log(`Spotify Lite API is running at http://localhost:${PORT}`);
});
